<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BENNY'S MUSIC</title>
  <style>
    body {
      font-family: sans-serif;
      background: #111;
      color: #fff;
      text-align: center;
      padding: 30px 15px;
      margin: 0;
    }

    h1 {
      font-size: 2.2rem;
      letter-spacing: 2px;
      margin-bottom: 5px;
    }

    .subtitle {
      color: #888;
      margin-bottom: 30px;
    }

    /* Grid Layout */
    .grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      max-width: 900px;
      margin: 0 auto;
    }

    .card {
      background: #222;
      border-radius: 10px;
      padding: 15px;
      width: 200px;
      cursor: pointer;
      border: 1px solid #333;
    }

    .card:hover {
      border-color: #888;
    }

    .card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 6px;
    }

    .card h3 {
      font-size: 1rem;
      margin: 10px 0 0;
    }

    /* Single Album View */
    .view {
      display: none;
      background: #222;
      border-radius: 12px;
      padding: 25px;
      max-width: 400px;
      margin: 0 auto;
      border: 1px solid #333;
    }

    .view img {
      width: 220px;
      height: 220px;
      border-radius: 8px;
      object-fit: cover;
    }

    .code-box {
      background: #000;
      border: 1px dashed #666;
      padding: 10px;
      margin: 8px 0;
      font-family: monospace;
      color: #00ffcc;
      border-radius: 4px;
    }

    .btn {
      display: inline-block;
      margin-top: 15px;
      padding: 10px 18px;
      background: #fff;
      color: #000;
      font-weight: bold;
      border-radius: 6px;
      text-decoration: none;
      border: none;
      cursor: pointer;
    }

    .btn-back {
      background: #444;
      color: #fff;
      margin-right: 8px;
    }
  </style>
</head>
<body>

  <h1>BENNY'S MUSIC</h1>
  <p class="subtitle" id="subHeader">Choose an album to download</p>

  <!-- ALL 5 ALBUMS ON FRONT PAGE -->
  <div class="grid" id="gallery">
    
    <div class="card" onclick="openAlbum('rabbit')">
      <img src="https://via.placeholder.com/300/333/fff?text=Rabbit+Hole" alt="Rabbit Hole Orchestra">
      <h3>Rabbit Hole Orchestra</h3>
    </div>

    <div class="card" onclick="openAlbum('dwarf')">
      <img src="https://via.placeholder.com/300/333/fff?text=Morph+Dwarf" alt="Morph Dwarf">
      <h3>Morph Dwarf</h3>
    </div>

    <div class="card" onclick="openAlbum('kingdoms')">
      <img src="https://via.placeholder.com/300/333/fff?text=Forgotten+Kingdoms" alt="Forgotten Kingdoms">
      <h3>Forgotten Kingdoms</h3>
    </div>

    <div class="card" onclick="openAlbum('earth')">
      <img src="https://via.placeholder.com/300/333/fff?text=Earth+Jam" alt="Earth Jam">
      <h3>Earth Jam</h3>
    </div>

    <div class="card" onclick="openAlbum('karavan')">
      <img src="https://via.placeholder.com/300/333/fff?text=Kaleidoscope+Karavan" alt="Kaleidoscope Karavan">
      <h3>Kaleidoscope Karavan</h3>
    </div>

  </div>

  <!-- SINGLE ALBUM DETAILS PAGE -->
  <div class="view" id="albumView">
    <img id="viewImg" src="" alt="Album Cover">
    <h2 id="viewTitle"></h2>
    <p>Redeem code:</p>
    
    <div id="codeContainer"></div>

    <button class="btn btn-back" onclick="showGallery()">← Back</button>
    <a id="redeemBtn" href="#" target="_blank" class="btn">Redeem Here</a>
  </div>

  <script>
    // EDIT YOUR CODES & REDEEM LINKS HERE
    const albums = {
      'rabbit': {
        title: 'Rabbit Hole Orchestra',
        img: 'https://via.placeholder.com/300/333/fff?text=Rabbit+Hole',
        codes: ['RABBIT-01', 'RABBIT-02'],
        link: 'https://bandcamp.com/yum'
      },
      'dwarf': {
        title: 'Morph Dwarf',
        img: 'https://via.placeholder.com/300/333/fff?text=Morph+Dwarf',
        codes: ['DWARF-01'],
        link: 'https://bandcamp.com/yum'
      },
      'kingdoms': {
        title: 'Forgotten Kingdoms',
        img: 'https://via.placeholder.com/300/333/fff?text=Forgotten+Kingdoms',
        codes: ['KINGDOM-01'],
        link: 'https://bandcamp.com/yum'
      },
      'earth': {
        title: 'Earth Jam',
        img: 'https://via.placeholder.com/300/333/fff?text=Earth+Jam',
        codes: ['EARTH-01'],
        link: 'https://bandcamp.com/yum'
      },
      'karavan': {
        title: 'Kaleidoscope Karavan',
        img: 'https://via.placeholder.com/300/333/fff?text=Kaleidoscope+Karavan',
        codes: ['KARAVAN-01'],
        link: 'https://bandcamp.com/yum'
      }
    };

    function openAlbum(key) {
      const data = albums[key];
      document.getElementById('gallery').style.display = 'none';
      document.getElementById('subHeader').style.display = 'none';

      document.getElementById('viewImg').src = data.img;
      document.getElementById('viewTitle').innerText = data.title;
      document.getElementById('redeemBtn').href = data.link;

      const codeBox = document.getElementById('codeContainer');
      codeBox.innerHTML = '';
      data.codes.forEach(code => {
        const div = document.createElement('div');
        div.className = 'code-box';
        div.innerText = code;
        codeBox.appendChild(div);
      });

      document.getElementById('albumView').style.display = 'block';
    }

    function showGallery() {
      document.getElementById('albumView').style.display = 'none';
      document.getElementById('gallery').style.display = 'flex';
      document.getElementById('subHeader').style.display = 'block';
    }
  </script>

</body>
</html>
